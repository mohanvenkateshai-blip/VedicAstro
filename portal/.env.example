# Portal environment (copy to .env.local — never commit secrets)

# CVCE calculation engine (server-side only; browser calls the portal API)
CVCE_BASE_URL=https://vedicastro-cvce.fly.dev
# Shared only with CVCE. Server-side: never name this NEXT_PUBLIC_*.
# Required by portal server calls in production; optional for unauthenticated local CVCE.
CVCE_SERVICE_TOKEN=

# Fail-closed server-only gate. Keep false until the canonical Muhurta
# calculation and comprehension gates are accepted. Never use NEXT_PUBLIC_*.
NATIVE_MUHURTA_RESEARCH_ENABLED=false

# Neon Postgres — saved charts (Production/Preview on Vercel; add to Development for local dev)
# Vercel CLI does NOT download production secrets — copy from dashboard or use:
#   DATABASE_URL='postgres://...' npm run db:schema
DATABASE_URL=

# NextAuth v5 + Google OAuth
AUTH_SECRET=                          # npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google Cloud Console → Authorized redirect URI:
#   https://<your-portal-domain>/api/auth/callback/google

# AES-256 birth PII encryption at rest (exactly 32 UTF-8 bytes; server-side only)
ENCRYPTION_KEY=
