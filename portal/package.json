{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-structured-data.mjs",
    "prebuild": "node scripts/sync-structured-data.mjs",
    "data:sync": "node scripts/sync-structured-data.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck && npm run build",
    "verify:gate": "bash ../scripts/verification_gate.sh",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:schema:remote": "node scripts/migrate-remote.mjs",
    "db:corpus-schema": "bash ../scripts/apply-supabase-corpus-schema.sh",
    "test:unit": "node --test src/lib/*.test.mts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/accessibility",
    "test:visual": "playwright test --project=chromium tests/visual",
    "test:responsive": "playwright test tests/responsive",
    "test:interaction": "playwright test tests/interaction",
    "test:e2e:baselines": "playwright test --project=chromium tests/visual --update-snapshots"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.108.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.41.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
