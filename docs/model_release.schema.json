{
  "$id": "https://vedicastro.local/schemas/ModelRelease/1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "manifest": {
      "additionalProperties": true,
      "title": "Manifest",
      "type": "object"
    },
    "manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Hash",
      "type": "string"
    },
    "release_id": {
      "minLength": 1,
      "title": "Release Id",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "created_at",
    "manifest",
    "manifest_hash"
  ],
  "title": "ModelRelease",
  "type": "object",
  "x-artifact-version": "1.0.0"
}
