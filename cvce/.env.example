# VedicAstro CVCE — runtime configuration.
# Copy to `.env` for local dev; in production set these as real env vars.
# No secrets belong in this file.

# --- Server ---
CVCE_HOST=0.0.0.0
CVCE_PORT=8400

# --- Portal-to-CVCE service authentication ---
# Production requires authentication by default. Generate one high-entropy
# value and configure the exact same secret as CVCE_SERVICE_TOKEN in the portal.
CVCE_ENVIRONMENT=development
CVCE_SERVICE_TOKEN=
# Local development defaults to auth off. Set true to test the production
# boundary locally. Production always requires auth regardless of this flag.
# Never commit a real token.
CVCE_REQUIRE_SERVICE_AUTH=false

# --- CORS allowlist (comma-separated). MUST be set to the portal origin(s)
#     in production. Defaults below are local dev only. ---
CVCE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Calculation ---
CVCE_DEFAULT_AYANAMSA=LAHIRI
# Directory containing licensed Swiss .se1 data files. Native Muhurta refuses
# the analytical Moshier fallback when these files are absent.
CVCE_SWISS_EPHEMERIS_PATH=
NATIVE_MUHURTA_RESEARCH_ENABLED=false
# Divisional charts (Shodashvarga) included in /chart. Comma-separated D-numbers.
CVCE_VARGAS=1,2,3,4,7,9,10,12,16,24,30,60

# --- Person Timeline append-only ledger ---
# Local development defaults to /tmp. Production should enable writes only
# with a durable, access-controlled path; raw birth inputs are never stored.
CVCE_TIMELINE_DB_PATH=/tmp/vedicastro-person-timeline.sqlite3
CVCE_TIMELINE_WRITES_ENABLED=true

# --- Rate limiting (per client IP) ---
CVCE_RATE_LIMIT_REQUESTS=60
CVCE_RATE_LIMIT_WINDOW=60

# --- GraphRAG rules (Phase 4) ---
# When 1/true: /predict transit house rules come from graph.json.
# When unset/0: hardcoded transit_rules.py (regression fallback).
# CVCE_GRAPH_AS_RULES=1
# Raw research API plane (disabled by default). When enabled, both a durable
# SQLite path and a dedicated token are mandatory. Never reuse a browser token.
CVCE_RESEARCH_MODE_ENABLED=false
CVCE_RESEARCH_DB_PATH=
# Directory containing the durable research database. In production this must
# be an actual mounted filesystem and RESEARCH_DB_PATH must resolve beneath it.
CVCE_RESEARCH_MOUNT_PATH=
CVCE_RESEARCH_SERVICE_TOKEN=
